# Configuración de entorno local sin Docker
# Copia este archivo como .env.local y personaliza según tu configuración

# Base de datos MySQL local
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sistema_visitas
DB_USERNAME=visitas_user
DB_PASSWORD=secret

# Redis local
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# URLs locales
APP_URL=http://localhost:8000
VITE_APP_URL=http://localhost:3000
VITE_API_URL=http://localhost:8000/api

# Configuración de email (Mailhog)
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FROM_ADDRESS=noreply@visitas.local

# Configuración de archivos
FILESYSTEM_DISK=local

# Configuración de colas
QUEUE_CONNECTION=redis

# Configuración de caché
CACHE_DRIVER=redis

# Configuración de sesiones
SESSION_DRIVER=redis