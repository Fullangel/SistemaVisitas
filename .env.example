# Configuración de la Aplicación
APP_NAME="Sistema Nacional de Visitas"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://tudominio.com
APP_TIMEZONE=America/Santiago

# Configuración de la Base de Datos
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=sistema_visitas
DB_USERNAME=root
DB_PASSWORD=password

# Configuración de Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# Configuración de Mail
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu-email@gmail.com
MAIL_PASSWORD=tu-contraseña
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@tudominio.com
MAIL_FROM_NAME="Sistema Nacional de Visitas"

# Configuración de JWT
JWT_SECRET=generar-con-php-artisan-jwt-secret

# Configuración de Frontend
VITE_API_URL=https://tudominio.com/api
VITE_APP_NAME="Sistema Nacional de Visitas"

# Configuración de Seguridad
SANCTUM_STATEFUL_DOMAINS=tudominio.com,www.tudominio.com
SESSION_DOMAIN=.tudominio.com

# Configuración de Logs
LOG_CHANNEL=daily
LOG_LEVEL=error

# Configuración de Queue
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=redis
CACHE_DRIVER=redis
SESSION_DRIVER=redis

# Configuración de Archivos
FILESYSTEM_DISK=local
MAX_FILE_SIZE=10240
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx,xls,xlsx

# Configuración de Notificaciones
NOTIFICATION_EMAIL_ENABLED=true
NOTIFICATION_PUSH_ENABLED=true